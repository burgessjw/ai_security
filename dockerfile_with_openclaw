FROM opensandbox/code-interpreter:v1.1.0

# 【新增】将 APT 源更换为阿里云镜像（加速下载）
RUN sed -i 's/archive.ubuntu.com/mirrors.aliyun.com/g' /etc/apt/sources.list \
    && sed -i 's/security.ubuntu.com/mirrors.aliyun.com/g' /etc/apt/sources.list \
    && apt-get update

# 安装 Node 24 + OpenClaw
RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y nodejs \
    && NODE_DIR=$(ls -d /opt/node/v22* | head -1) \
    && rm -f $NODE_DIR/bin/node $NODE_DIR/bin/npm $NODE_DIR/bin/npx $NODE_DIR/bin/corepack \
    && ln -s /usr/bin/node     $NODE_DIR/bin/node \
    && ln -s /usr/bin/npm      $NODE_DIR/bin/npm \
    && ln -s /usr/bin/npx      $NODE_DIR/bin/npx \
    && ln -s /usr/bin/corepack $NODE_DIR/bin/corepack \
    && npm install -g openclaw@latest

